$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.0.s"},[{"#n":"$r2"}],"\n","^He's contemplating on your words, but does not say a word.","\n",{"->":"IvanLocalisation"},{"#f":5}],"c-1":["ev",{"^->":"IvanRegret.0.c-0.11.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.1.s"},[{"#n":"$r2"}],"\n","^I did it because I fear death, I did it because I'm a coward and a monster. Let me die, that's the least I can do, to die in great pain.","\n",[["ev",{"^->":"IvanRegret.0.c-0.11.c-1.9.0.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":18},{"s":["^it must be the fever speaking because you make no sense. Rest now, we'll take care of you.",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"IvanRegret.0.c-0.11.c-1.9.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.0.s"},[{"#n":"$r2"}],"\n","^You don't understand... he lay his head back, barely hiding his tears. You don't understand...","\n",{"->":"IvanLocalisation"},{"#f":5}]}],{"#f":5}]}],{"#f":5}]}],{"#f":1}],"IvanLocalisation":[[["ev",{"^->":"IvanLocalisation.0.0.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":18},{"s":["^•\twhere are you from ?",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"IvanLocalisation.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.0.s"},[{"#n":"$r2"}],"\n","^I'm from the more eastern part of Zlamanyy, I grew up in Zazno, a big city on the other side of the mountains.","\n",[["ev",{"^->":"IvanLocalisation.0.c-0.9.0.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":18},{"s":["^oh so you're a local?",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"IvanLocalisation.0.c-0.9.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.0.s"},[{"#n":"$r2"}],"\n","^Yes, I descent from a line of miners. I'm actually the first in my line to not have worked in a mine.","\n",[["ev",{"^->":"IvanLocalisation.0.c-0.9.c-0.9.0.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":18},{"s":["^